{
  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler pages deploy*)",
      "Bash(npx wrangler pages deploy*)",
      "Bash(wrangler pages project*)",
      "Bash(npx wrangler pages project*)",
      "Bash(wrangler secret*)",
      "Bash(npx wrangler secret*)",
      "Bash(wrangler pages secret*)",
      "Bash(npx wrangler pages secret*)",
      "Bash(wrangler d1 * --remote*)",
      "Bash(npx wrangler d1 * --remote*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/check.sh" }
        ]
      }
    ]
  }
}
